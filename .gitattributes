# Normalize line endings so Windows checkouts don't churn every file.
* text=auto

*.js    text eol=lf
*.jsx   text eol=lf
*.css   text eol=lf
*.html  text eol=lf
*.json  text eol=lf
*.md    text eol=lf
*.svg   text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf

# Windows scripts must keep CRLF to stay double-clickable.
*.bat   text eol=crlf
*.cmd   text eol=crlf
