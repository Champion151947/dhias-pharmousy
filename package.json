{
  "name": "dhias-pharmousy",
  "version": "1.0.0",
  "private": true,
  "description": "Full-stack pharmacy e-commerce platform for Dhiya's Pharmousy, Thisuur, Ollur",
  "workspaces": [
    "api",
    "web"
  ],
  "scripts": {
    "dev": "concurrently -n api,web -c green,cyan \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "npm run dev --workspace api",
    "dev:web": "npm run dev --workspace web",
    "build": "npm run build --workspace web",
    "start": "npm run start --workspace api",
    "serve": "npm run build && npm run start",
    "images:generate": "npm run images:generate --workspace api",
    "smoke": "node scripts/smoke.mjs",
    "lint": "npm run lint --workspace api && npm run lint --workspace web"
  },
  "devDependencies": {
    "concurrently": "^9.1.0",
    "vite-plugin-svgr": "^5.2.0"
  },
  "engines": {
    "node": ">=20.11.0"
  }
}
