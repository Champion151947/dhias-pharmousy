########################################################################
# Dhiya's Pharmousy - environment configuration
# Copy this file to `api/.env` (or `.env` in the project root) and fill in
# real values. Every variable has a safe development default, so the app
# runs with ZERO configuration and seeds a demo catalogue on first boot.
#
# There is no database to provision. The dataset is a single JSON file.
########################################################################

# ---------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------
NODE_ENV=development
PORT=4000

# Comma-separated list of allowed browser origins (CORS).
# In production the API and storefront are served from one origin, so this
# is only needed while developing with Vite on a separate port.
WEB_URL=http://localhost:5173,http://localhost:4173

# ---------------------------------------------------------------------
# Data
# ---------------------------------------------------------------------
# Where db.json and the uploads folder live. Leave unset to use
# `<project>/data`. Set this to a mounted volume on hosts with a
# read-only image, e.g. DATA_DIR=/data
# DATA_DIR=

# Auto-seed the demo catalogue when the store is empty. Ignored in
# production, where an empty store simply stays empty.
AUTO_SEED=true

# ---------------------------------------------------------------------
# Auth / JWT   (MUST be changed before deploying)
# ---------------------------------------------------------------------
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
JWT_EXPIRES_IN=7d
BCRYPT_ROUNDS=10

# The seeded administrator account
ADMIN_EMAIL=admin@dhiaspharmousy.in
ADMIN_PASSWORD=Admin@12345
ADMIN_PHONE=9142225559

# ---------------------------------------------------------------------
# Phone OTP / SMS provider
# ---------------------------------------------------------------------
# `console` prints the OTP to the server log (development).
# `msg91`    uses MSG91 FLOW_ID for Indian OTP delivery.
# `twilio`   uses Twilio Verify.
OTP_PROVIDER=console
OTP_EXPIRY_MINUTES=5
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=30

MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=
MSG91_FLOW_ID=

TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=

# ---------------------------------------------------------------------
# Store details (used on invoices and in the storefront footer)
# ---------------------------------------------------------------------
STORE_NAME=Dhiya's Pharmousy
STORE_ADDRESS_LINE_1=Shop No. 4, Main Bazaar Road
STORE_ADDRESS_LINE_2=Thisuur, Ollur
STORE_CITY=Thisuur
STORE_DISTRICT=Ollur
STORE_STATE=Tamil Nadu
STORE_PINCODE=682310
STORE_PHONE=9142225559
STORE_WHATSAPP=919142225559
GSTIN=REPLACE_WITH_YOUR_GSTIN
DRUG_LICENSE_NUMBER=REPLACE_WITH_YOUR_DRUG_LICENSE

# ---------------------------------------------------------------------
# Commerce rules
# ---------------------------------------------------------------------
CURRENCY=INR
FREE_DELIVERY_ABOVE=499
DELIVERY_FEE=39

# Indian law requires the displayed MRP to already include every tax, so
# listed prices are tax-inclusive and nothing is added at checkout.
# Leave at 0 unless you deliberately want a separate tax line on the order.
TAX_RATE=0

DELIVERY_SLOTS=09:00 AM - 01:00 PM,01:00 PM - 05:00 PM,05:00 PM - 09:00 PM
MAX_UPLOAD_MB=5
